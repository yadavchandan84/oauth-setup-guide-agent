# Backend agent API configuration.
# Copy to .env for local dev. One KEY=value per line; # comments and blanks allowed.
# Secrets are left empty here — never commit real keys. Set them in Render (sync:false).

# HTTP port. Locally 8787; Render injects PORT=10000.
PORT=8787

# development | production | test
NODE_ENV=development

# Comma-separated allowed CORS origins (exact match, trailing / stripped).
# Blank falls back to the localhost defaults. In production set this to your Vercel URL.
ALLOWED_ORIGINS=

# OpenAI key for live generation. Blank -> /api/generate returns 503 CONFIG_MISSING.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Tavily key for live doc search. Blank -> /api/generate returns 503 CONFIG_MISSING.
TAVILY_API_KEY=

# Upstash Redis REST creds for durable, shareable links. Both or neither.
# Blank -> the file store is used (ephemeral on Render's free disk).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Store backend: auto | memory | file | upstash. auto picks upstash iff creds exist, else file.
STORE=auto

# Directory for the file store, relative to the start command cwd (backend/ -> backend/.data).
DATA_DIR=./.data

# Live-generation rate limit: max requests per window.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=3600000

# Max simultaneous live generations before 503 BUSY.
MAX_CONCURRENT_GENERATIONS=2

# Per-request live-generation timeout in ms.
GENERATION_TIMEOUT_MS=120000

# Cache TTL for live-generated guides, in hours.
CACHE_TTL_HOURS=168

# Number of proxy hops to trust (Render sits behind one proxy -> 1).
TRUST_PROXY=1

# debug | info | warn | error
LOG_LEVEL=info
