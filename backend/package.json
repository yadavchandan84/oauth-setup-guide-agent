{
  "name": "oauth-guide-agent-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.3 <23"
  },
  "scripts": {
    "predev": "node ../scripts/sync-shared.mjs",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "prebuild": "node ../scripts/sync-shared.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "pretypecheck": "node ../scripts/sync-shared.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "node ../scripts/sync-shared.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "4.21.2",
    "cors": "2.8.5",
    "helmet": "8.0.0",
    "express-rate-limit": "7.4.1",
    "openai": "4.73.0",
    "zod": "3.23.8",
    "@upstash/redis": "1.34.3",
    "nanoid": "5.0.9"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "tsx": "4.19.2",
    "vitest": "2.1.5",
    "supertest": "7.0.0",
    "@types/express": "4.17.21",
    "@types/cors": "2.8.17",
    "@types/supertest": "6.0.2",
    "@types/node": "22.9.1"
  }
}
